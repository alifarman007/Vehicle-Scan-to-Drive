# Copy to .env.local and fill in. Never prefix these with NEXT_PUBLIC_.
# Supabase dashboard → Project Settings → API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret key (sb_secret_...). A legacy service_role key also works,
# as SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# Optional. Base URL put inside QR codes. Defaults to the current site's origin.
# NEXT_PUBLIC_APP_URL=https://ridepass.vercel.app
